# AnyPC OS image (bootable container, Fedora bootc base).
# Build:  podman build -f build/Containerfile -t anypc-os:dev .
# See build/README.md for turning it into an installer ISO.
ARG FEDORA=44
FROM quay.io/fedora/fedora-bootc:${FEDORA}

# Graphics, audio, networking, controllers and the console session.
RUN dnf -y install \
      gamescope chromium python3 \
      mesa-dri-drivers mesa-vulkan-drivers vulkan-loader \
      pipewire pipewire-pulseaudio wireplumber \
      NetworkManager NetworkManager-wifi bluez polkit \
      greetd \
      pciutils \
    && dnf clean all

# Boot splash: the AnyPC mark from power-on until the console session starts,
# and again at shutdown. Rebuild the initramfs so it includes the theme.
RUN dnf -y install plymouth plymouth-plugin-script plymouth-plugin-label \
    && dnf clean all
COPY session/plymouth/anypc /usr/share/plymouth/themes/anypc
COPY session/plymouth/plymouthd.conf /etc/plymouth/plymouthd.conf
COPY session/plymouth/dracut.conf /usr/lib/dracut/dracut.conf.d/50-anypc-splash.conf
COPY session/plymouth/kargs.toml /usr/lib/bootc/kargs.d/10-anypc-splash.toml
RUN set -e; kver=$(cd /usr/lib/modules && echo *); \
    test "$(echo "$kver" | wc -w)" -eq 1; \
    env DRACUT_NO_XATTR=1 dracut --force --no-hostonly --reproducible \
      /usr/lib/modules/$kver/initramfs.img "$kver"; \
    lsinitrd /usr/lib/modules/$kver/initramfs.img | grep -q 'plymouth/themes/anypc/anypc.script'

# The shell (UI + service) and session scripts.
COPY shell/ui /usr/share/anypc/shell/ui
COPY shell/daemon/anypc_shelld /usr/share/anypc/shell/daemon/anypc_shelld
COPY session/anypc-session session/anypc-session-inner session/anypc-shelld /usr/bin/
COPY session/anypc.desktop /usr/share/wayland-sessions/anypc.desktop
COPY session/systemd/anypc-shelld.service /usr/lib/systemd/user/anypc-shelld.service
COPY session/greetd.toml /etc/greetd/config.toml
COPY session/anypc-update /usr/libexec/anypc-update
COPY session/systemd/system/ /usr/lib/systemd/system/
COPY session/polkit/50-anypc.rules /usr/share/polkit-1/rules.d/50-anypc.rules
COPY session/sysusers/anypc.conf /usr/lib/sysusers.d/anypc.conf

RUN chmod 0755 /usr/bin/anypc-session /usr/bin/anypc-session-inner /usr/bin/anypc-shelld /usr/libexec/anypc-update \
    && sed -i -e '/^VARIANT=/d' -e '/^VARIANT_ID=/d' /usr/lib/os-release \
    && printf 'VARIANT="AnyPC OS"\nVARIANT_ID=anypc\n' >> /usr/lib/os-release \
    && (getent group anypc >/dev/null || groupadd -r anypc) \
    && systemctl enable greetd.service NetworkManager.service bluetooth.service \
    && systemctl set-default graphical.target \
    && bootc container lint
